<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Contestant Panel</title>
  <link rel="stylesheet" href="/styles.css" />
</head>
<body>
  <main class="layout">
    <section class="main-content">
      <h1>Contestant Panel</h1>
      <div class="card">
        <h3>Join Game</h3>
        <label for="joinCode">Join Code</label>
        <input id="joinCode" tabindex="2" placeholder="Enter your code" autocomplete="one-time-code" />
        <button id="connectButton" type="button" tabindex="3">Connect as Player</button>
      </div>

      <div class="card">
        <h3>Connection Status</h3>
        <p>Socket: <strong id="playerConnectionStatus">Disconnected</strong></p>
        <p>Selected player: <strong id="selectedPlayer">—</strong></p>
      </div>

      <div class="card">
        <h3>Game Status</h3>
        <p id="playerPhase">Phase: setup</p>
        <p id="playerClue">Current clue: None</p>
      </div>


      <div class="card" id="answerPanel" hidden role="dialog" aria-modal="false" aria-labelledby="answerPanelHeading">
        <h3 id="answerPanelHeading">Submit Answer</h3>
        <label for="answerInput">Your response</label>
        <input id="answerInput" placeholder="Type your answer" tabindex="6" />
        <button id="submitAnswerButton" type="button" tabindex="7">Submit Answer</button>
        <p id="answerInfo">You can submit once per buzz lock.</p>
      </div>

      <div class="card">
        <h3>Buzz In</h3>
        <button id="buzzButton" type="button" disabled aria-label="Buzz in" data-i18n="player.buzzButton" tabindex="5">Buzz</button>
        <p id="buzzInfo">Buzzing is disabled until a clue is revealed.</p>
      </div>
    </section>
  </main>


  <audio id="sfxClueReveal" preload="auto" src="/audio/clue-reveal.mp3"></audio>
  <audio id="sfxBuzzOpen" preload="auto" src="/audio/buzz-open.mp3"></audio>
  <audio id="sfxBuzzLock" preload="auto" src="/audio/buzz-lock.mp3"></audio>
  <audio id="sfxQuickTimerStart" preload="auto" src="/audio/quick-timer-start.mp3"></audio>
  <audio id="sfxQuickTimerExpiry" preload="auto" src="/audio/quick-timer-expiry.mp3"></audio>
  <script src="/socket.io/socket.io.js"></script>
  <script src="/player.js"></script>
</body>
</html>
