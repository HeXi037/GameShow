<!doctype html>
<html>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Contestant Panel</title>
  <link rel="stylesheet" href="/styles.css" />
</head>
<body>
  <main class="layout">
    <section>
      <h1>Contestant Panel</h1>
      <div class="card">
        <h3>Join Game</h3>
        <label for="joinCode">Join Code</label>
        <input id="joinCode" placeholder="Enter your code" autocomplete="one-time-code" />
        <button id="connectButton" type="button">Connect as Player</button>
      </div>

      <div class="card">
        <h3>Connection Status</h3>
        <p>Socket: <strong id="playerConnectionStatus">Disconnected</strong></p>
        <p>Selected player: <strong id="selectedPlayer">—</strong></p>
      </div>

      <div class="card">
        <h3>Game Status</h3>
        <p id="playerPhase">Phase: setup</p>
        <p id="playerClue">Current clue: None</p>
      </div>

      <div class="card">
        <h3>Buzz In</h3>
        <button id="buzzButton" type="button" disabled>Buzz</button>
        <p id="buzzInfo">Buzzing is disabled until a clue is revealed.</p>
      </div>
    </section>
  </main>

  <script src="/socket.io/socket.io.js"></script>
  <script src="/player.js"></script>
</body>
</html>
