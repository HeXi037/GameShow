<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Mogul Money Board</title>
  <link rel="stylesheet" href="/styles.css" />
</head>
<body>
  <main class="layout">
    <section class="main-content">
      <h1>Mogul Money</h1>
      <div id="phaseBanner"></div>
      <div class="board-wrap"><div id="board" class="board"></div></div>
      <div id="revealed"></div>
    </section>
    <aside class="side-panel">
      <h2>Scoreboard</h2>
      <div class="scoreboard-wrap"><div id="scoreboard"></div></div>
    </aside>
  </main>

  <audio id="sfxClueReveal" preload="auto" src="/audio/clue-reveal.mp3"></audio>
  <audio id="sfxBuzzOpen" preload="auto" src="/audio/buzz-open.mp3"></audio>
  <audio id="sfxBuzzLock" preload="auto" src="/audio/buzz-lock.mp3"></audio>
  <audio id="sfxQuickTimerStart" preload="auto" src="/audio/quick-timer-start.mp3"></audio>
  <audio id="sfxQuickTimerExpiry" preload="auto" src="/audio/quick-timer-expiry.mp3"></audio>
  <script src="/socket.io/socket.io.js"></script>
  <script src="/viewer.js"></script>
</body>
</html>
