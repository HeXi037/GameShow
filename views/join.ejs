<!doctype html><html lang="en"><head><meta charset='UTF-8'/><meta name='viewport' content='width=device-width, initial-scale=1.0'/><title>Join Game</title><link rel='stylesheet' href='/styles.css'/></head><body><main class='layout'><section><h1>Contestant Panel</h1><div class='card'><h3>Join Game</h3><label for='roomCode'>Room Code</label><input id='roomCode' placeholder='ROOM1' tabindex='1' /><label for='joinCode'>Join Code</label><input id='joinCode' placeholder='Join code' tabindex='2'/><button id='connectButton' type='button' tabindex='3'>Connect as Player</button></div><div class='card'><p>Socket: <strong id='playerConnectionStatus'>Disconnected</strong></p><p>Selected player: <strong id='selectedPlayer'>—</strong></p></div><div class='card'><p id='playerPhase'>Phase: setup</p><p id='playerClue'>Current clue: None</p><button id='buzzButton' type='button' disabled aria-label='Buzz in' tabindex='5'>Buzz</button><p id='buzzInfo'>Buzzing is disabled until a clue is revealed.</p></div><div class="card" id="playerMinigame"><h3>Minigame</h3><div id="playerMinigameBody">No minigame active.</div></div></section></main><script src='/socket.io/socket.io.js'></script><script src='/player.js'></script></body></html>
