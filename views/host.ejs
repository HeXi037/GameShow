<!doctype html>
<html>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Host Panel</title>
  <link rel="stylesheet" href="/styles.css" />
</head>
<body>
  <main class="layout">
    <section>
      <h1>Host Control Panel</h1>
      <div class="card">
        <h3>Connection Status</h3>
        <p>Socket: <strong id="hostConnectionStatus">Connecting...</strong></p>
        <p>Host presence: <strong id="hostPresenceStatus">Unknown</strong></p>
        <p>Connected viewers: <strong id="viewerCount">0</strong></p>
        <p>Connected players: <strong id="playerConnectionCount">0</strong></p>
        <p>Player sessions: <strong id="playerSessions">None</strong></p>
        <ul id="connectionNotices"></ul>
      </div>
      <form id="roomSetupForm" method="post" action="/host/setup" enctype="multipart/form-data" class="card">
        <label>Player names (comma separated)</label>
        <input name="roomCode" placeholder="ROOM1" required />
        <input name="playerNames" placeholder="Ludwig, QT, Slime, Atrioc" required />
        <label>Top finalists for Quick Money</label>
        <select name="topFinalists" id="topFinalists" required>
          <option value="2" selected>2</option>
          <option value="3">3</option>
          <option value="4">4</option>
          <option value="5">5</option>
        </select>
        <label>Custom game JSON (optional)</label>
        <input type="file" name="boardFile" accept="application/json" />
        <label>Or load from local data/ file (optional)</label>
        <input name="localDataFile" placeholder="sample-game.json" />
        <button type="submit">Start New Game</button>
      </form>


      <div class="card">
        <h3>Game Definition Editor</h3>
        <form id="gameDefinitionForm">
          <label>Definition Name</label>
          <input name="name" placeholder="spring_showdown" required />
          <div id="gameDefinitionError"></div>
          <h4>Round 1 (5 categories × 5 clues)</h4>
          <div id="round1Editor"></div>
          <h4>Round 2 (5 categories × 5 clues)</h4>
          <div id="round2Editor"></div>
          <label>Mogul Multiplier Category Index (0-4)</label>
          <input name="mogulCategoryIndex" type="number" min="0" max="4" required value="0" />
          <label>Mogul Multiplier Clue Index (0-4)</label>
          <input name="mogulClueIndex" type="number" min="0" max="4" required value="0" />
          <h4>Quick Money Prompts (5)</h4>
          <div id="quickMoneyEditor"></div>
          <button type="submit">Save Definition</button>
          <button type="button" id="loadDefinitionBtn">Load Definition</button>
        </form>
      </div>

      <div class="card">
        <h3>Export Session</h3>
        <label>Room Code</label>
        <input id="exportRoomCode" placeholder="Current active room" />
        <div class="controls">
          <button id="exportJson" type="button">Export JSON</button>
          <button id="exportCsv" type="button">Export CSV</button>
        </div>
      </div>

      <div class="card">
        <h3>Session Recovery</h3>
        <button id="refreshSessions" type="button">Refresh Sessions</button>
        <div id="sessionList"></div>
      </div>


      <div class="card">
        <h3>Audio</h3>
        <label><input id="soundEnabledToggle" type="checkbox" checked /> Enable sounds</label>
      </div>

      <div class="card">
        <h3>Current Board Actions</h3>
        <div id="hostBoard"></div>
      </div>

      <div class="card">
        <h3>Player Join Links / Codes</h3>
        <div id="joinLinks"></div>
      </div>

      
      <div class="card">
        <h3>Rule Configuration</h3>
        <form id="rulesForm">
          <label><input type="checkbox" name="reopenOnIncorrect" /> Reopen buzz automatically when locked player is scored incorrect</label>
          <label><input type="checkbox" name="allowRebuzzBySamePlayer" /> Allow same player to rebuzz on same clue</label>
          <label>Max attempts per clue (blank = unlimited)</label>
          <input name="maxAttemptsPerClue" type="number" min="1" />
          <label>Buzz timeout seconds (0 disables timeout)</label>
          <input name="buzzTimeoutSeconds" type="number" min="0" value="0" />
          <label>Tie-breaker mode</label>
          <select name="tieBreakerMode">
            <option value="scoreFallback">Score-based fallback</option>
            <option value="hostPick">Manual host pick</option>
            <option value="suddenDeath">Sudden-death clue</option>
          </select>
          <label>Round 1 multiplier</label>
          <input name="round1Multiplier" type="number" min="0.1" step="0.1" value="1" />
          <label>Round 2 multiplier</label>
          <input name="round2Multiplier" type="number" min="0.1" step="0.1" value="1" />
          <label>Round 1 custom values (comma-separated)</label>
          <input name="round1Values" placeholder="100,200,300,400,500" />
          <label>Round 2 custom values (comma-separated)</label>
          <input name="round2Values" placeholder="200,400,600,800,1000" />
          <label>Wrong-answer penalty mode</label>
          <select name="wrongAnswerPenaltyMode">
            <option value="fixed">Fixed</option>
            <option value="percent">Percent</option>
            <option value="none">No penalty</option>
          </select>
          <label>Wrong-answer penalty value (percent uses %)</label>
          <input name="wrongAnswerPenaltyValue" type="number" min="0" value="100" />
          <button type="submit">Save Rules</button>
        </form>
      </div>
<div class="card">
        <h3>Revealed Answer, Buzz Controls, and Scoring</h3>
        <div id="hostReveal"></div>
      </div>

      <div class="card" id="multiplierCard" hidden>
        <h3>Mogul Multiplier (Round 2)</h3>
        <form id="multiplierForm">
          <input name="playerName" placeholder="Player Name" required />
          <input name="wager" type="number" min="0" required />
          <select name="correct"><option value="true">Correct</option><option value="false">Incorrect</option></select>
          <button type="submit">Apply Wager</button>
        </form>
      </div>

      <div class="card">
        <h3>Quick Money Controls</h3>
        <div id="quickMoneyStatus"></div>
        <form id="quickTimer"><input type="number" name="seconds" value="20" /><button type="submit">Start Timer</button></form>
        <form id="quickSubmit">
          <input name="playerName" placeholder="Finalist" required />
          <input name="promptIndex" type="number" min="0" max="4" required />
          <input name="answer" placeholder="Answer" required />
          <input name="points" type="number" min="1" max="10" required />
          <button type="submit">Add Quick Money Score</button>
        </form>
      </div>
    </section>
    <aside>
      <h2>Live Scoreboard</h2>
      <div id="scoreboard"></div>
    </aside>
  </main>
  <script>window.__INITIAL_STATE__ = <%- JSON.stringify(state) %>;</script>

  <audio id="sfxClueReveal" preload="auto" src="/audio/clue-reveal.mp3"></audio>
  <audio id="sfxBuzzOpen" preload="auto" src="/audio/buzz-open.mp3"></audio>
  <audio id="sfxBuzzLock" preload="auto" src="/audio/buzz-lock.mp3"></audio>
  <audio id="sfxQuickTimerStart" preload="auto" src="/audio/quick-timer-start.mp3"></audio>
  <audio id="sfxQuickTimerExpiry" preload="auto" src="/audio/quick-timer-expiry.mp3"></audio>
  <script src="/socket.io/socket.io.js"></script>
  <script src="/host.js"></script>
</body>
</html>
